{
  "name": "joi-to-typescript",
  "description": "Convert Joi Schemas to TypeScript interfaces",
  "version": "5.0.0",
  "author": "Jono Clarnette",
  "keywords": [
    "joi",
    "ts",
    "typescript",
    "hapi",
    "interface"
  ],
  "license": "MIT",
  "repository": {
    "url": "https://github.com/mrjono1/joi-to-typescript",
    "type": "git"
  },
  "funding": "https://github.com/mrjono1/joi-to-typescript?sponsor=1",
  "bugs": {
    "url": "https://github.com/mrjono1/joi-to-typescript/issues"
  },
  "main": "./dist/main/index.js",
  "module": "./dist/module/index.js",
  "typings": "./dist/types/index.d.ts",
  "exports": {
    "import": "./dist/module/index.js",
    "require": "./dist/main/index.js"
  },
  "scripts": {
    "build:esm": "tsc --module es2020 --outDir ./dist/module",
    "build:cjs": "tsc --module commonjs --outDir ./dist/main",
    "build:dts": "tsc --declaration --emitDeclarationOnly --outDir ./dist/types",
    "build": "pnpm run build:esm && pnpm run build:cjs && pnpm run build:dts",
    "format": "prettier --write \"src/**/*.ts\"",
    "lint": "eslint 'src/**'",
    "test": "vitest run",
    "coverage": "vitest run --coverage --silent",
    "pub": "pnpm run build && pnpm publish"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "@typescript-eslint/eslint-plugin": "7.18.0",
    "@typescript-eslint/parser": "7.18.0",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "8.57.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.6",
    "joi": "18.2.3",
    "prettier": "3.8.3",
    "typescript": "5.8.3",
    "vite": "8.2.2",
    "vitest": "4.1.10"
  },
  "peerDependencies": {
    "joi": "17.x"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
